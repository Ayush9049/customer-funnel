# ── Backend Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values

APP_NAME=Analytics Platform MVP
APP_ENV=development

# Secret key for signing tokens / sessions (generate a strong random value for production)
SECRET_KEY=change-me-to-a-random-secret-in-production

# ── Database ──────────────────────────────────────────────
# Use SQLite for local development; set a Postgres URL for production
DATABASE_URL=sqlite:///analytics.db

# Postgres credentials (used by docker-compose and Postgres DATABASE_URL)
POSTGRES_DB=analytics_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── App Settings ──────────────────────────────────────────
AUTO_CREATE_TABLES=true

# ── Demo / Seed Data ──────────────────────────────────────
DEMO_PROJECT_API_KEY=demo-key
